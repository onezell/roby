# ===========================================
# COOLIFY ENVIRONMENT VARIABLES
# ===========================================
# Add these to Coolify's environment variables section

# Production Domain (update with your actual domain)
SITE_URL=https://atticstudio.com

# Backend Admin URL
BACKEND_URL=https://atticstudio.com/admin

# ===========================================
# STRAPI SECRETS - GENERATE NEW ONES!
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Use different secrets for production!

STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=your-api-token-salt
STRAPI_ADMIN_JWT_SECRET=your-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=your-transfer-token-salt
STRAPI_JWT_SECRET=your-jwt-secret

# ===========================================
# DATABASE (Optional - SQLite by default)
# ===========================================
# Uncomment if using PostgreSQL
# POSTGRES_DB=attic_studio
# POSTGRES_USER=strapi
# POSTGRES_PASSWORD=changeme

# ===========================================
# NOTES
# ===========================================
# 1. Never commit real secrets to git
# 2. Generate new secrets for each environment
# 3. Coolify injects these at runtime
