# Docker Compose Environment Variables

# Production Domain (update this with your actual domain)
DOMAIN=atticstudio.com

# Strapi Admin Credentials (set these for first-time setup)
# ADMIN_EMAIL=admin@atticstudio.com
# ADMIN_PASSWORD=changeme

# Database Configuration
# Uncomment and configure if using PostgreSQL instead of SQLite
# POSTGRES_DB=attic_studio
# POSTGRES_USER=strapi
# POSTGRES_PASSWORD=changeme
