# ===========================================
# COOLIFY ENVIRONMENT VARIABLES
# ===========================================
# Add ONLY these variables to Coolify's environment section
# Coolify automatically provides SERVICE_FQDN_* and SERVICE_URL_* variables

# ===========================================
# STRAPI SECRETS - GENERATE NEW ONES!
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT: Use different secrets for production!

STRAPI_APP_KEYS=key1,key2,key3,key4
STRAPI_API_TOKEN_SALT=your-api-token-salt
STRAPI_ADMIN_JWT_SECRET=your-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=your-transfer-token-salt
STRAPI_JWT_SECRET=your-jwt-secret

# ===========================================
# COOLIFY AUTO-GENERATED (DO NOT ADD MANUALLY)
# ===========================================
# These are automatically provided by Coolify:
# - SERVICE_FQDN_BACKEND (backend public URL)
# - SERVICE_FQDN_FRONTEND (frontend public URL)
# - SERVICE_URL_BACKEND (backend URL with protocol)
# - SERVICE_URL_FRONTEND (frontend URL with protocol)

# ===========================================
# DATABASE (Optional - SQLite by default)
# ===========================================
# Uncomment if using PostgreSQL
# POSTGRES_DB=attic_studio
# POSTGRES_USER=strapi
# POSTGRES_PASSWORD=changeme

# ===========================================
# NOTES
# ===========================================
# 1. Never commit real secrets to git
# 2. Generate new secrets for each environment
# 3. Coolify automatically injects SERVICE_FQDN_* variables
# 4. Do NOT try to delete or modify SERVICE_FQDN_* variables in Coolify UI
